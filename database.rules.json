{
  "rules": {
    "state": {
      ".read": true,
      ".write": "auth != null",
      ".validate": "newData.hasChildren(['timestamp', 'config'])",
      "log": {
        ".indexOn": ["at"]
      }
    },
    "$testNs": {
      ".read": "$testNs.beginsWith('test_')",
      ".write": "$testNs.beginsWith('test_') && auth != null",
      ".validate": "newData.hasChildren(['timestamp', 'config'])",
      "log": {
        ".indexOn": ["at"]
      }
    }
  }
}
